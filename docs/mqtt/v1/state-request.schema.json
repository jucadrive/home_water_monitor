{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:home-water-monitor:mqtt:v1:state-request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventType",
    "deviceId",
    "probeId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventType": {
      "const": "STATE_REQUEST"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "probeId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    }
  }
}
