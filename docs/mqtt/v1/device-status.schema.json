{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:home-water-monitor:mqtt:v1:device-status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventType",
    "deviceId",
    "bootId",
    "statusSeq",
    "uptimeMs",
    "replyToProbeId",
    "controlWindow",
    "state",
    "sessionId",
    "sampleCount",
    "finalized",
    "round",
    "attempt",
    "controlMode",
    "controlReady",
    "fault",
    "commandResult",
    "lastExecution",
    "lastRelease"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventType": {
      "const": "DEVICE_STATUS"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "bootId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "statusSeq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "uptimeMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "replyToProbeId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      ]
    },
    "controlWindow": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "windowId",
            "validForMs"
          ],
          "properties": {
            "windowId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "validForMs": {
              "const": 10000
            }
          }
        }
      ]
    },
    "state": {
      "enum": [
        "IDLE",
        "MEASURING",
        "PREPARING",
        "WAIT_PUBACK",
        "WAIT_CONFIRMATION",
        "BACKOFF",
        "MANUAL_WAIT"
      ]
    },
    "sessionId": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      ]
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60
    },
    "finalized": {
      "type": "boolean"
    },
    "round": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "controlMode": {
      "enum": [
        "MQTT",
        "UART"
      ]
    },
    "controlReady": {
      "type": "boolean"
    },
    "fault": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": "CONTROL_UNAVAILABLE"
        }
      ]
    },
    "commandResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "commandType",
            "sessionId",
            "outcome",
            "reason"
          ],
          "properties": {
            "commandId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "commandType": {
              "enum": [
                "START",
                "RETRY"
              ]
            },
            "sessionId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "outcome": {
              "enum": [
                "ACCEPTED",
                "REJECTED"
              ]
            },
            "reason": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "enum": [
                    "BOOT_MISMATCH",
                    "WINDOW_INVALID",
                    "WINDOW_EXPIRED",
                    "BUSY",
                    "BUFFER_PENDING",
                    "NO_PENDING_BUFFER",
                    "SESSION_MISMATCH",
                    "SESSION_REUSED",
                    "COMMAND_CONFLICT",
                    "NOT_READY",
                    "DEVICE_FAULT"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "lastExecution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "commandType",
            "sessionId",
            "windowId"
          ],
          "properties": {
            "commandId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "commandType": {
              "enum": [
                "START",
                "RETRY"
              ]
            },
            "sessionId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "windowId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          }
        }
      ]
    },
    "lastRelease": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sessionId",
            "preservationResult",
            "preservedSampleCount",
            "reason"
          ],
          "properties": {
            "sessionId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "preservationResult": {
              "enum": [
                "NORMAL",
                "INCOMPLETE"
              ]
            },
            "preservedSampleCount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60
            },
            "reason": {
              "const": "PRESERVATION_CONFIRMED"
            }
          }
        }
      ]
    }
  }
}
