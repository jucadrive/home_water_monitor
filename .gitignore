# Repository-wide rules. Keep shared ignore rules in this file.

# IntelliJ / VS Code / other local IDE state
.idea/
.run/
.vscode/
*.iml
*.iws
*.ipr
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# Gradle caches and generated output
.gradle/
build/
out/
bin/
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/
!**/src/main/**/bin/
!**/src/test/**/bin/

# Local credentials; commit only empty/example templates
auth.env
postgres.env
tunnel.token
mqtt.env
mqtt-lan.env
device-mqtt.json
mosquitto.passwd
mosquitto.acl
.env
.env.*
!.env.example

# Generated documentation, logs, and OS files
HELP.md
*.log
*.hprof
.DS_Store
Thumbs.db

# NetBeans local output
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ESP-IDF local SDK, configuration, generated dependencies and Python output
.tools/
sdkconfig
sdkconfig.old
sdkconfig.local
sdkconfig.personal
sdkconfig.personal.old
managed_components/
__pycache__/
*.pyc
/firmware/esp32/wifi.local.json
/firmware/esp32/main/local_config.h
/firmware/esp32/main/local_personal_config.h
/infra/device-test/secrets.local.json
/infra/device-test/private/
/infra/personal/secrets/
/infra/personal/app.jar
/.codex-remote-attachments/

# Android SDK locations and signing material
local.properties
*.jks
*.keystore
captures/
